# ============================================================
# SHOP TANTRA — environment template (placeholders ONLY).
# Never commit real secrets. Copy to .env / .env.local and fill in values.
# Shipping Xpress token lives server-side only (never NEXT_PUBLIC_).
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://user:password@host:5432/shoptantra"

# Optional, Supabase-only: the pooler (Supavisor) host that serves this project,
# e.g. aws-1-ap-south-1.pooler.supabase.com. Not a secret (public DNS name).
# Set it when the DATABASE_URL above names a different pooler cluster — Supavisor
# then answers every query with
#   FATAL: (ENOTFOUND) tenant/user postgres.<project-ref> not found
# because tenant lookup happens inside the cluster the hostname belongs to.
# The app only ever replaces the HOST; the password stays untouched.
SUPABASE_POOLER_HOST=""

# --- Auth / JWT ---
# REQUIRED in production. The app refuses to sign or verify tokens without it,
# so a deployment can never silently fall back to a publicly-known key.
JWT_SECRET="change-me"

# --- Executive (corporate) bootstrap passwords ---
# OPTIONAL. Used only by /api/corporate/login to create or repair the three
# executive accounts (Founder / CEO & MD / Chairman) on first use.
# When a value is absent the matching account is left completely untouched, so
# these are safe to remove once the accounts exist. Rotating the value here
# changes that executive's password on their next login attempt.
EXECUTIVE_FOUNDER_PASSWORD=""
EXECUTIVE_CEO_PASSWORD=""
EXECUTIVE_CHAIRMAN_PASSWORD=""

# --- Site-owner ADMIN account ---
# Used only by scripts/seed-founder.cjs, which seeds the ADMIN account that is
# separate from the three executive portals. REQUIRED for that script to run:
# it refuses to execute without it, so an absent value can never reset the
# account to something guessable.
# (This file previously held a literal plaintext ADMIN password in source
# control. If that account is still in use anywhere, rotate it.)
ADMIN_ACCOUNT_PASSWORD=""
ADMIN_ACCOUNT_EMAIL="jadavnileshbhai2006@gmail.com"

# --- Razorpay (the ONLY online payment gateway) ---
# NEXT_PUBLIC_RAZORPAY_KEY_ID is intentionally public (it is the checkout key id).
# RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET are server-side ONLY and must
# never be given a NEXT_PUBLIC_ prefix.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- Cash on Delivery ---
# COD has no configuration; it is always available in checkout.

# Retired gateways: CASHFREE and PHONEPE were removed. Do NOT add
# NEXT_PUBLIC_CASHFREE_APP_ID, CASHFREE_SECRET_KEY, PHONEPE_MERCHANT_ID or
# PHONEPE_SALT_KEY — no code reads them any more.

# --- Shipping Xpress (Phase 3) ---
SHIPPING_XPRESS_ENABLED="false"
SHIPPING_XPRESS_BASE_URL="https://shippingxpress.in/ship"
SHIPPING_XPRESS_API_TOKEN=""
SHIPPING_XPRESS_ENVIRONMENT="production"
SHIPPING_XPRESS_TIMEOUT_MS="15000"
# Free-form value for the required `shipping_mode` field (the API validates that
# it is present but does not restrict its value).
SHIPPING_XPRESS_SHIPPING_MODE="Surface"
# Optional: set to "true" to require a pickupLocationId on every seller before
# booking (the live API does not require an origin field — it is bound to the token).
SHIPPING_XPRESS_REQUIRE_PICKUP_LOCATION_ID="false"
# Optional: enables the status webhook. Leave empty until Shipping Xpress
# documents a real callback + signature format.
SHIPPING_XPRESS_WEBHOOK_SECRET=""

# NOTE: this is the ONLY shipping provider. Shiprocket, Delhivery, BlueDart and
# India Post were removed from production code. Each seller configures their own
# pickup location in Seller > Store Settings; ShopTantra has NO global/fake
# warehouse address.

